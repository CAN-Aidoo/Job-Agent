# Database
DATABASE_URL=postgresql://jobagent:jobagent@localhost:5432/jobagent

# Redis
REDIS_URL=redis://localhost:6379

# Google AI (Gemini)
GOOGLE_AI_API_KEY=your-google-ai-api-key
GOOGLE_AI_MODEL=gemini-2.0-flash

# Gmail OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# S3 / File Storage
S3_BUCKET=jobagent-files
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Auth
JWT_SECRET=change-me-in-production

# Push Notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# Adzuna
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Token Encryption
TOKEN_ENCRYPTION_KEY=change-me-32-byte-key-here-xxxxx
