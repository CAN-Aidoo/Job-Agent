{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@jobagent/shared": ["./packages/shared/src"],
      "@jobagent/shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": [
    "packages/shared/src/**/*",
    "services/api/src/**/*",
    "services/orchestrator/src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
